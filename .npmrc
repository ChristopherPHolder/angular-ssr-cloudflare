# Angular is pinned to 22.3.0-next.2, the exact release that the ngp build
# inside @push-based/vite-plugin-ngp was compiled from. npm's semver rules
# never match a prerelease against a plain range, so every Angular library's
# peer range (">=22.0.0", ">17.1.0", ...) fails to resolve even though the
# libraries are compatible. Drop this once ngp tracks a stable Angular release.
legacy-peer-deps=true
